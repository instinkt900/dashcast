[Unit]
Description=dashcast display (framebuffer Home Assistant dashboard)
After=network-online.target
Wants=network-online.target
# We own the framebuffer; keep the login prompt off tty1.
Conflicts=getty@tty1.service

[Service]
Type=simple
WorkingDirectory=/opt/dashcast
Environment=PYTHONPATH=/opt/dashcast
# Quiet the console so kernel messages / a blinking cursor / blanking don't
# draw over our frames. Best-effort; failures here are non-fatal.
ExecStartPre=-/bin/sh -c 'setterm --blank 0 --powerdown 0 --cursor off >/dev/tty1 2>/dev/null; echo 0 >/sys/class/graphics/fbcon/cursor_blink 2>/dev/null; dmesg -n 1 2>/dev/null; true'
ExecStart=/usr/bin/python3 -m dashcast display --config /etc/dashcast/config.toml
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
